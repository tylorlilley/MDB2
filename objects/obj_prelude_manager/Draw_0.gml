draw_set_halign(fa_center);
draw_set_font(ft_title);

draw_set_color(C_WHITE);
draw_text_outlined(room_width/2, 82, "THE STORY");
draw_text_outlined(room_width/2, 122, "SO FAR");
draw_text_outlined(room_width/2, 80, "THE STORY");
draw_text_outlined(room_width/2, 120, "SO FAR");

draw_set_font(ft_block_blueprint);
draw_text_outlined(room_width/2, 256, "Princess Amalia has been kidnapped by the evil Dr. Mischevio. It is up to YOU, the Mighty Dive Bomber, to save the day! Your reputation as Metro City's guardian and protector depends on it.", C_WHITE, 20, 232);
draw_text_outlined(room_width/2, 512, "Just reaching Dr. Mishcevio will be an arduous journey. He has stolen the princess away to the very top of his nefarious castle keep, located in the center of his private island estate. You must infiltrate the fortress, rescue the princess, and put a stop to his evil plans!", C_WHITE, 20, 232);
draw_text_outlined(room_width/2, 768, "...But be warned. Dr. Mischevio is as infamous for his paranoia and as he is for his love of puzzles. The path to the princess will surely be blocked by all manner of locks and barriers that you will have to use your wits to get past.", C_WHITE, 20, 232);
draw_text_outlined(room_width/2, 1024, "You, the Mighty Dive Bomber, will arrive on the outer shores of Mischevio Isle. You will have to work your way through the Isle's beaches, the forests, and even Dr. Mischevio's vile factories if you wish to reach his fortress at the center. You will have to fight for every inch!", C_WHITE, 20, 232);
draw_text_outlined(room_width/2, 1280, "Good luck, and godspeed, Mighty Dive Bomber!!", C_WHITE, 20, 232);

